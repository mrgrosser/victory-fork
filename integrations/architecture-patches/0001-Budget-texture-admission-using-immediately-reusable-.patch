+    #[test]
+    fn budget_excludes_retired_pieces_until_reusable() {
+        let mut pool = Pool::new(2);
+        let (piece, _, _) = pool.take(BLOCK / 2, 512, 0, || Some(())).unwrap();
+        assert_eq!(pool.free_bytes, BLOCK / 2);
+        pool.give(piece, 1);
+        pool.reclaim(REST, 0, true);
+        assert_eq!(pool.free_bytes, BLOCK / 2);
+        pool.reclaim(REST + 1, 1, true);
+        assert_eq!(pool.free_bytes, BLOCK);
+        pool.reclaim(REST + 2, 0, true);
+        assert_eq!(pool.free_bytes, 0);
+    }
