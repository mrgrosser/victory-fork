@@ -0,0 +1,40 @@
+"""Summarize checkpoint_bench presents inside a visually verified time window."""
+import argparse
+import json
+import math
+from datetime import datetime
+from statistics import mean, median
+
+
+def summarize(lines, start, seconds):
+    if not math.isfinite(seconds) or seconds <= 0:
+        raise ValueError("duration must be finite and positive")
+    end = start + seconds
+    stamps = []
+    for line in lines:
+        if "checkpoint_bench: present " in line:
+            stamps.append(datetime.fromisoformat(line.split()[0]).timestamp())
+    if not stamps or stamps[0] > start or stamps[-1] < end:
+        raise ValueError("trace does not cover the full window")
+    if any(b < a for a, b in zip(stamps, stamps[1:])):
+        raise ValueError("present timestamps moved backwards")
+    times = sorted(1000 * (b - a) for a, b in zip(stamps, stamps[1:])
+                   if start <= a and b <= end)
+    if not times or sum(times) == 0:
+        raise ValueError("window contains insufficient complete frame intervals")
+    n = len(times)
+    worst = times[-math.ceil(n / 100):]
+    return dict(presents=sum(start <= t < end for t in stamps),
+                fps=sum(start <= t < end for t in stamps) / seconds,
+                low_1pct_fps=1000 / mean(worst), median_ms=median(times),
+                p95_ms=times[math.ceil(n*.95)-1], p99_ms=times[math.ceil(n*.99)-1],
+                max_ms=times[-1], complete_intervals=n)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("trace", type=argparse.FileType("r", encoding="utf-8"))
+    parser.add_argument("start_epoch_ms", type=int, help="UTC timestamp of the verified scene start")
+    parser.add_argument("--seconds", type=float, default=60)
+    args = parser.parse_args()
+    print(json.dumps(summarize(args.trace, args.start_epoch_ms / 1000, args.seconds), indent=2))
