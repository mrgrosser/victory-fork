From d6f77b11adfd3fa85cd6b380bd04ce0b5383a31e Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Thu, 26 Nov 2026 07:01:28 -0600
Subject: [PATCH 1/3] Record opt-in release present timing and draw counters
 for checkpoint trials

---
 crates/victory-gpu/src/host.rs | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/crates/victory-gpu/src/host.rs b/crates/victory-gpu/src/host.rs
index d1088cc..9a0cf65 100644
--- a/crates/victory-gpu/src/host.rs
+++ b/crates/victory-gpu/src/host.rs
@@ -8660,6 +8660,7 @@ struct Presenter {
 /// The frame rate, shown in the window's caption every second and logged
 /// every few seconds.
 struct Meter {
+    measure_checkpoint: bool,
     since: std::time::Instant,
     frames: u32,
     #[cfg(feature = "diagnostics")]
@@ -8674,6 +8675,7 @@ impl Meter {
     fn new() -> Self {
         let now = std::time::Instant::now();
         Meter {
+            measure_checkpoint: std::env::var("VICTORY_BENCH_PRESENTS").as_deref() == Ok("1"),
             since: now,
             frames: 0,
             #[cfg(feature = "diagnostics")]
@@ -8692,6 +8694,9 @@ impl Meter {
 
     /// Counts a presented frame.
     fn frame(&mut self, hwnd: HWND) {
+        if self.measure_checkpoint {
+            tracing::info!(target: "checkpoint_bench", drawn = crate::draw::drawn(), "present");
+        }
         #[cfg(feature = "diagnostics")]
         tracing::debug!(target: "victory_gpu::frame", token = crate::frame::current(), "present");
         #[cfg(feature = "diagnostics")]
@@ -8724,6 +8729,9 @@ impl Meter {
         });
         let dropped = crate::draw::take_dropped() as f64 / frames;
         let indirect = crate::list::take_indirect() as f64 / frames;
+        if self.measure_checkpoint {
+            tracing::info!(target: "checkpoint_bench", frames, ms, draws, dropped, indirect, copy_ms, back_ms, back_mb, "interval");
+        }
         let mesh_largest = MESH_GROUPS[0].swap(0, Ordering::Relaxed);
         let mesh_groups = MESH_GROUPS[1].swap(0, Ordering::Relaxed) as f64 / frames;
         let refused = BUDGET_NOTES[0].swap(0, Ordering::Relaxed) as f64 / frames;
